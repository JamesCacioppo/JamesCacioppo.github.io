{
  "name": "modern-engineer",
  "private": true,
  "description": "James Cacioppo's documentation and blog, built with Hugo and Docsy.",
  "repository": "github:JamesCacioppo/JamesCacioppo.github.io",
  "homepage": "https://jamescacioppo.github.io/",
  "author": "James Cacioppo",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "hugo": "hugo",
    "serve": "hugo server --buildDrafts --buildFuture",
    "build": "hugo --gc --minify --cleanDestinationDir --printPathWarnings --panicOnWarning",
    "build:production": "npm run build",
    "build:preview": "hugo --environment development --buildDrafts --buildFuture --gc --minify --cleanDestinationDir --printPathWarnings --panicOnWarning --baseURL \"${DEPLOY_PRIME_URL:-http://localhost:1313/}\"",
    "check:links": "node scripts/check-site.mjs",
    "test": "npm run build && npm run check:links"
  },
  "devDependencies": {
    "hugo-extended": "0.169.0",
    "parse5": "8.0.1",
    "sass-embedded": "1.107.1"
  },
  "overrides": {
    "hugo-extended": {
      "adm-zip": "0.6.1"
    }
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
